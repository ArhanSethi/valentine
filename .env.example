# Anthropic: create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Twilio: from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the bot calls from and that you text (E.164, like +15551234567)
TWILIO_PHONE_NUMBER=

# Your own cell number. The bot only takes orders from this number and texts results here.
OWNER_PHONE_NUMBER=
# The name the agent says it's calling on behalf of
OWNER_NAME=

# Public HTTPS address of this server, with no trailing slash (for example, your ngrok URL)
PUBLIC_URL=

# Optional
DEFAULT_COUNTRY_CODE=+1
TTS_VOICE=
